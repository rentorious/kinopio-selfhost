+// kinopio-selfhost: media summaries (docs/MEDIA-SUMMARIES.md in kinopio-selfhost).
+// Holds the audio or video file waiting in the Media summary dialog.
+import { defineStore } from 'pinia'
+
+export const useMediaSummaryStore = defineStore('mediaSummary', {
+  state: () => ({
+    file: null,
+    position: null
+  }),
+  getters: {
+    isVisible: (state) => Boolean(state.file)
+  },
+  actions: {
+    open ({ file, position }) {
+      this.file = file
+      this.position = position
+    },
+    close () {
+      this.file = null
+      this.position = null
+    }
+  }
+})
