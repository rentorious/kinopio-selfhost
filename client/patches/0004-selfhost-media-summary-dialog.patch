diff --git a/src/components/dialogs/MediaSummary.vue b/src/components/dialogs/MediaSummary.vue
new file mode 100644
index 0000000..d42ef92
--- /dev/null
+++ b/src/components/dialogs/MediaSummary.vue
@@ -0,0 +1,418 @@
+<script setup>
+// kinopio-selfhost: the Media summary dialog (docs/MEDIA-SUMMARIES.md §2, §11 in kinopio-selfhost).
+// Preview a dropped audio or video file, pick the part to process, then send it to
+// the server, which hands it to the transcription worker on your own PC.
+import { reactive, computed, watch, onMounted, onBeforeUnmount, ref } from 'vue'
+
+import { useMediaSummaryStore } from '@/stores/useMediaSummaryStore'
+import { useCardStore } from '@/stores/useCardStore'
+import { useUserStore } from '@/stores/useUserStore'
+import { useSpaceStore } from '@/stores/useSpaceStore'
+import { useApiStore } from '@/stores/useApiStore'
+import { useUploadStore } from '@/stores/useUploadStore'
+import { useGlobalStore } from '@/stores/useGlobalStore'
+
+import utils from '@/utils.js'
+import consts from '@/consts.js'
+
+import { nanoid } from 'nanoid'
+
+const mediaSummaryStore = useMediaSummaryStore()
+const cardStore = useCardStore()
+const userStore = useUserStore()
+const spaceStore = useSpaceStore()
+const apiStore = useApiStore()
+const uploadStore = useUploadStore()
+const globalStore = useGlobalStore()
+
+const LANGUAGE_KEY = 'kinopio-selfhost-media-language'
+const MAX_MS = 180 * 60 * 1000
+const LANGUAGES = ['auto', 'en', 'sl', 'sr', 'hr', 'bs', 'it', 'de', 'fr', 'es', 'pt', 'nl', 'pl', 'cs', 'ru', 'uk', 'ja', 'zh']
+
+const mediaElement = ref(null)
+let statusTimer
+
+const state = reactive({
+  objectUrl: null,
+  durationMs: null,
+  canPreview: true,
+  startMs: 0,
+  endMs: null,
+  startText: '0:00',
+  endText: '',
+  language: 'auto',
+  topic: '',
+  status: null, // { online, lastSeenAt, model }
+  statusError: false
+})
+
+const file = computed(() => mediaSummaryStore.file)
+const visible = computed(() => mediaSummaryStore.isVisible)
+const isVideo = computed(() => (file.value?.type || '').startsWith('video/'))
+
+const languageName = (code) => {
+  if (code === 'auto') { return 'Detect language' }
+  try {
+    return new Intl.DisplayNames(['en'], { type: 'language' }).of(code)
+  } catch (error) {
+    return code
+  }
+}
+
+const format = (ms) => {
+  if (ms === null || ms === undefined) { return '' }
+  const total = Math.max(0, Math.floor(ms / 1000))
+  const h = Math.floor(total / 3600)
+  const m = Math.floor((total % 3600) / 60)
+  const s = String(total % 60).padStart(2, '0')
+  return h > 0 ? `${h}:${String(m).padStart(2, '0')}:${s}` : `${m}:${s}`
+}
+const parse = (text) => {
+  const match = /^\s*(?:(\d+):)?(\d{1,2}):(\d{2})\s*$/.exec(text || '')
+  if (!match) { return null }
+  const [, h, m, s] = match
+  if (Number(s) > 59) { return null }
+  return ((Number(h || 0) * 60 + Number(m)) * 60 + Number(s)) * 1000
+}
+
+const fileSize = computed(() => {
+  if (!file.value) { return '' }
+  const mb = file.value.size / 1024 / 1024
+  return mb >= 1 ? `${mb.toFixed(1)} MB` : `${Math.ceil(file.value.size / 1024)} KB`
+})
+const selectedMs = computed(() => {
+  if (state.endMs === null) { return null }
+  return state.endMs - state.startMs
+})
+const rangeError = computed(() => {
+  if (state.endMs === null) { return null }
+  if (state.endMs <= state.startMs) { return 'The end has to be after the start' }
+  if (state.endMs - state.startMs > MAX_MS) { return 'Pick at most 3 hours' }
+  return null
+})
+const statusText = computed(() => {
+  if (state.statusError) { return 'Couldn\'t reach the server' }
+  if (!state.status) { return 'Checking the transcriber…' }
+  if (state.status.online) { return `Transcriber online${state.status.model ? ` (${state.status.model})` : ''}` }
+  if (state.status.lastSeenAt) {
+    const seen = new Date(state.status.lastSeenAt)
+    return `Transcriber offline (last seen ${seen.toLocaleString([], { dateStyle: 'short', timeStyle: 'short' })})`
+  }
+  return 'Transcriber offline'
+})
+const canSummarize = computed(() => Boolean(state.status?.online && !rangeError.value && state.endMs !== null))
+
+// open / close
+
+watch(visible, (value) => {
+  if (value) { init() } else { cleanup() }
+})
+onMounted(() => {
+  window.addEventListener('keydown', closeOnEscape)
+})
+onBeforeUnmount(() => {
+  window.removeEventListener('keydown', closeOnEscape)
+  cleanup()
+})
+
+const init = () => {
+  cleanup()
+  state.objectUrl = URL.createObjectURL(file.value)
+  state.durationMs = null
+  state.canPreview = true
+  state.startMs = 0
+  state.endMs = null
+  state.startText = '0:00'
+  state.endText = ''
+  state.topic = ''
+  try {
+    state.language = window.localStorage.getItem(LANGUAGE_KEY) || 'auto'
+  } catch (error) {
+    state.language = 'auto'
+  }
+  state.status = null
+  state.statusError = false
+  checkStatus()
+  statusTimer = setInterval(checkStatus, 10000)
+}
+const cleanup = () => {
+  clearInterval(statusTimer)
+  if (state.objectUrl) { URL.revokeObjectURL(state.objectUrl) }
+  state.objectUrl = null
+}
+const close = () => {
+  mediaSummaryStore.close()
+}
+const closeOnEscape = (event) => {
+  if (visible.value && event.key === 'Escape') { close() }
+}
+
+const checkStatus = async () => {
+  try {
+    const options = await apiStore.requestOptions({ method: 'GET' })
+    const response = await fetch(`${consts.apiHost()}/media-summaries/status`, options)
+    if (!response.ok) { throw new Error(response.status) }
+    state.status = await response.json()
+    state.statusError = false
+  } catch (error) {
+    console.warn('🚑 media summary status', error)
+    state.statusError = true
+  }
+}
+
+// preview and range
+
+const loadedMetadata = () => {
+  const seconds = mediaElement.value?.duration
+  if (!Number.isFinite(seconds)) { return previewFailed() }
+  state.durationMs = Math.round(seconds * 1000)
+  setEnd(Math.min(state.durationMs, MAX_MS))
+}
+const previewFailed = () => {
+  // the browser can't play this codec: process the whole file (the PC caps it at the real length)
+  state.canPreview = false
+  state.durationMs = null
+  setStart(0)
+  setEnd(MAX_MS)
+}
+const setStart = (ms) => {
+  state.startMs = Math.max(0, Math.round(ms))
+  state.startText = format(state.startMs)
+}
+const setEnd = (ms) => {
+  state.endMs = Math.round(ms)
+  state.endText = format(state.endMs)
+}
+const setStartAtPlayhead = () => setStart((mediaElement.value?.currentTime || 0) * 1000)
+const setEndAtPlayhead = () => setEnd((mediaElement.value?.currentTime || 0) * 1000)
+const resetRange = () => {
+  setStart(0)
+  setEnd(Math.min(state.durationMs ?? MAX_MS, MAX_MS))
+}
+const updateStartText = () => {
+  const ms = parse(state.startText)
+  if (ms !== null) { setStart(ms) } else { state.startText = format(state.startMs) }
+}
+const updateEndText = () => {
+  const ms = parse(state.endText)
+  if (ms !== null) { setEnd(state.durationMs ? Math.min(ms, state.durationMs) : ms) } else { state.endText = format(state.endMs) }
+}
+const playSelection = () => {
+  const element = mediaElement.value
+  if (!element) { return }
+  element.currentTime = state.startMs / 1000
+  element.play()
+}
+const updateLanguage = () => {
+  try {
+    window.localStorage.setItem(LANGUAGE_KEY, state.language)
+  } catch (error) {}
+}
+
+// actions
+
+const uploadAsFile = () => {
+  const { file: selected, position } = mediaSummaryStore
+  close()
+  uploadStore.addCardsAndUploadFiles({ files: [selected], position, asFile: true })
+}
+
+const summarize = () => {
+  if (!canSummarize.value) { return }
+  const { file: selected, position } = mediaSummaryStore
+  const startMs = state.startMs
+  const endMs = state.endMs
+  const language = state.language
+  const topic = state.topic.trim()
+  close()
+
+  const cardId = nanoid()
+  const spaceId = spaceStore.id
+  const highestCardZ = utils.highestItemZ(cardStore.getAllCards)
+  cardStore.createCard({ position: { x: position.x, y: position.y, z: highestCardZ }, name: consts.uploadPlaceholder, id: cardId }, true)
+  // the card's usual upload progress bar; like card uploads, keyed by card only
+  uploadStore.addPendingUpload({ key: `media-summary/${cardId}`, fileName: selected.name, cardId })
+  const finishProgress = () => uploadStore.updatePendingUpload({ cardId, percentComplete: 100 })
+
+  const fields = { spaceId, cardId, fileName: selected.name, startMs, endMs, language, topic, x: Math.round(position.x), y: Math.round(position.y) }
+  const fail = (message) => {
+    finishProgress()
+    showError(cardId, selected.name, message)
+  }
+  const send = ({ method, url, headers = {}, body }) => {
+    const request = new XMLHttpRequest()
+    const done = new Promise((resolve, reject) => {
+      request.onload = () => resolve(request)
+      request.onerror = () => reject(new Error('the upload was interrupted'))
+    })
+    request.upload.onprogress = (event) => {
+      if (!event.lengthComputable) { return }
+      const percentComplete = Math.min(99, Math.floor(event.loaded / event.total * 100))
+      uploadStore.updatePendingUpload({ cardId, percentComplete })
+    }
+    request.open(method, url)
+    Object.keys(headers).forEach(key => request.setRequestHeader(key, headers[key]))
+    request.send(body)
+    return done
+  }
+  const errorMessage = (request) => {
+    try {
+      return JSON.parse(request.responseText).message || `upload failed (${request.status})`
+    } catch (error) {
+      return `upload failed (${request.status})`
+    }
+  }
+  const auth = userStore.apiKey ? { Authorization: userStore.apiKey } : {}
+
+  // Straight to the bucket with a signed link: Railway's proxy cuts request
+  // bodies off after 5 minutes, too short for a long video on a home connection.
+  // Without a bucket (local development) the server takes the file itself.
+  const uploadDirect = async () => {
+    const response = await fetch(`${consts.apiHost()}/media-summaries/direct`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', ...auth },
+      body: JSON.stringify({ ...fields, mimeType: selected.type, size: selected.size })
+    })
+    const body = await response.json().catch(() => ({}))
+    if (response.status === 404 && body.error === 'direct_unsupported') { return false }
+    if (!response.ok) { throw new Error(body.message || `upload failed (${response.status})`) }
+    const { jobId, url, method, headers } = body
+    let put
+    try {
+      put = await send({ method, url, headers, body: selected })
+    } catch (error) {
+      fetch(`${consts.apiHost()}/media-summaries/${jobId}`, { method: 'DELETE', headers: auth }).catch(() => {})
+      throw error
+    }
+    if (put.status < 200 || put.status >= 300) {
+      fetch(`${consts.apiHost()}/media-summaries/${jobId}`, { method: 'DELETE', headers: auth }).catch(() => {})
+      throw new Error(`upload failed (${put.status})`)
+    }
+    const confirmed = await fetch(`${consts.apiHost()}/media-summaries/${jobId}/uploaded`, { method: 'POST', headers: auth })
+    if (confirmed.status !== 202) {
+      const error = await confirmed.json().catch(() => ({}))
+      throw new Error(error.message || `upload failed (${confirmed.status})`)
+    }
+    return true
+  }
+  const uploadThroughServer = async () => {
+    const form = new FormData()
+    Object.keys(fields).forEach(key => form.append(key, String(fields[key])))
+    form.append('file', selected)
+    const request = await send({ method: 'POST', url: `${consts.apiHost()}/media-summaries`, headers: auth, body: form })
+    if (request.status !== 202) { throw new Error(errorMessage(request)) }
+  }
+
+  const upload = async () => {
+    try {
+      if (!await uploadDirect()) { await uploadThroughServer() }
+      finishProgress() // the server updates the card from here on
+    } catch (error) {
+      fail(error.message || 'the upload failed')
+    }
+  }
+  upload()
+}
+
+const showError = (cardId, fileName, message) => {
+  const name = `⚠️ ${fileName} · ${message}`
+  cardStore.updateCard({ id: cardId, name })
+  globalStore.addNotification({ message: `Couldn't summarize ${fileName}: ${message}`, type: 'danger' })
+}
+</script>
+
+<template lang="pug">
+dialog.media-summary(v-if="visible" :open="visible" @click.left.stop @pointerdown.stop @keydown.esc="close" @keydown.stop)
+  section.title-section
+    .row.title-row
+      span Summarize {{ isVideo ? 'video' : 'audio' }}
+      button.small-button(@click="close" title="Cancel") ✕
+    p.file-name {{ file.name }} · {{ fileSize }}
+    p.status(:class="{ online: state.status && state.status.online, offline: state.statusError || (state.status && !state.status.online) }")
+      span.dot
+      span {{ statusText }}
+  section.preview-section
+    template(v-if="state.canPreview")
+      video(v-if="isVideo" ref="mediaElement" :src="state.objectUrl" controls preload="metadata" @loadedmetadata="loadedMetadata" @error="previewFailed")
+      audio(v-else ref="mediaElement" :src="state.objectUrl" controls preload="metadata" @loadedmetadata="loadedMetadata" @error="previewFailed")
+    p.badge.info(v-else) Your browser can't play this file, so the whole file will be processed (up to 3 hours).
+  section.range-section(v-if="state.canPreview")
+    .row
+      label Start
+      input.time(v-model="state.startText" @blur="updateStartText" @keydown.enter="updateStartText")
+      button(@click="setStartAtPlayhead") Set at playhead
+    .row
+      label End
+      input.time(v-model="state.endText" @blur="updateEndText" @keydown.enter="updateEndText")
+      button(@click="setEndAtPlayhead") Set at playhead
+    .row
+      span.selected(v-if="selectedMs !== null && !rangeError") Selected: {{ format(selectedMs) }}
+      span.badge.danger(v-if="rangeError") {{ rangeError }}
+    .row
+      button(@click="playSelection") Play from start
+      button(@click="resetRange") Whole file
+  section.options-section
+    .row
+      label Language
+      select(v-model="state.language" @change="updateLanguage")
+        option(v-for="code in LANGUAGES" :value="code" :key="code") {{ languageName(code) }}
+    .row
+      input.topic(v-model="state.topic" maxlength="500" placeholder="Topic hint (optional): subject, names, jargon")
+  section.actions-section
+    .row
+      button.success(:disabled="!canSummarize" @click="summarize") Summarize
+      button(@click="uploadAsFile") Upload as file
+      button(@click="close") Cancel
+</template>
+
+<style lang="stylus">
+dialog.media-summary
+  position fixed
+  left 50%
+  top 72px
+  transform translateX(-50%)
+  width 380px
+  max-width calc(100vw - 24px)
+  max-height calc(100vh - 96px)
+  overflow auto
+  z-index 1000
+  .title-row
+    justify-content space-between
+  .file-name
+    word-break break-all
+    opacity 0.8
+  .status
+    display flex
+    align-items center
+    gap 6px
+    .dot
+      width 8px
+      height 8px
+      border-radius 50%
+      background var(--secondary-active-background)
+    &.online .dot
+      background var(--success-background)
+    &.offline .dot
+      background var(--danger-background)
+  video
+    width 100%
+    max-height 200px
+    background black
+  audio
+    width 100%
+  .row
+    display flex
+    align-items center
+    gap 6px
+    margin-top 6px
+  label
+    min-width 64px
+  input.time
+    width 80px
+  input.topic
+    width 100%
+  select
+    flex 1
+  .selected
+    opacity 0.8
+</style>
