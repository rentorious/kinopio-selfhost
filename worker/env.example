# ~/.config/kinopio-worker/env — settings for the transcription worker.
# Quote values that contain spaces (it is read by systemd and by `source`).
# Use absolute paths: systemd user services don't load your shell's PATH.

# Your Railway app, and the same WORKER_TOKEN you set on the Railway service
SERVER_URL=https://your-app.up.railway.app
WORKER_TOKEN=

# whisper.cpp built with Vulkan
WHISPER_BIN=/home/you/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/you/whisper.cpp/models/ggml-large-v3.bin
# used once if large-v3 gets stuck repeating a line
WHISPER_FALLBACK_MODEL=/home/you/whisper.cpp/models/ggml-large-v2.bin
VAD_MODEL=/home/you/whisper.cpp/models/ggml-silero-v5.1.2.bin
# WHISPER_THREADS=8

FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

# Claude Code, logged in with your subscription (`claude auth status`)
CLAUDE_BIN=/home/you/.local/bin/claude
# CLAUDE_MODEL=sonnet
# Set to false only if your Claude Code is too old for --restricted
# CLAUDE_RESTRICTED=true
# CLAUDE_TIMEOUT_MS=900000

WORKER_GPU_NAME="AMD Radeon RX 9000 series"
# JOB_DIR=/home/you/.cache/kinopio-worker
