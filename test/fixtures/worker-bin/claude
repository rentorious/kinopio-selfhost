#!/usr/bin/env node
// Fake `claude -p`: writes the output files the worker prompt asks for.
// FAKE_CLAUDE_MODE: good (default) | bad (always invalid) | bad-once | slow
const fs = require('fs')
const path = require('path')
if (process.env.FAKE_CLAUDE_ARGS_LOG) fs.appendFileSync(process.env.FAKE_CLAUDE_ARGS_LOG, JSON.stringify(process.argv.slice(2)) + '\n')
const mode = process.env.FAKE_CLAUDE_MODE || 'good'
const fmt = ms => { const s = Math.floor(ms / 1000); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}` }
const marker = path.join('input', '.attempts')
const attempts = (fs.existsSync(marker) ? Number(fs.readFileSync(marker, 'utf8')) : 0) + 1
fs.writeFileSync(marker, String(attempts))
const write = () => {
  const segs = JSON.parse(fs.readFileSync('input/transcript.json', 'utf8'))
  const meta = JSON.parse(fs.readFileSync('input/meta.json', 'utf8'))
  const bad = mode === 'bad' || (mode === 'bad-once' && attempts === 1)
  const card = bad ? 'no title here ' + 'x'.repeat(4000) : `# The rhizosphere microbiome\n## Summary\nTopic hint was: ${meta.topic}.\n## Key points\n- Roots feed microbes\n- Microbes protect the vine`
  fs.mkdirSync('output/transcript', { recursive: true })
  fs.writeFileSync('output/card.md', card)
  const mid = Math.floor(segs.length / 2)
  const parts = [segs.slice(0, mid), segs.slice(mid)]
  parts.forEach((p, i) => {
    fs.writeFileSync(`output/transcript/00${i + 1}.md`, `---\nheading: Part ${i + 1}\nstart: ${fmt(p[0].startMs)}\nend: ${fmt(p[p.length - 1].endMs)}\n---\n${p.map(s => s.text.replace('rhesus fur', 'rhizosphere')).join(' ')}\n`)
  })
  fs.writeFileSync('output/corrections.md', '- rhesus fur → rhizosphere')
  console.log(JSON.stringify({ type: 'result', is_error: false, result: 'Wrote 2 sections.' }))
}
if (mode === 'slow') setTimeout(write, 60_000)
else write()
